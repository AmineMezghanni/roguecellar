module src/rogue/logic

import list
import option
import string

import src/rogue/util
import src/rogue/model
import src/rogue/dungeon

def eqPos(a: Pos, b: Pos): Bool =
  a.x == b.x && a.y == b.y


def findMonsterAt(monsters: List[Monster], p: Pos): Option[Monster] = monsters match {
  case Nil() => None()
  case Cons(m, rest) =>
    if (eqPos(m.pos, p)) Some(m) else findMonsterAt(rest, p)
}


def findMonsterById(monsters: List[Monster], id: Int): Option[Monster] = monsters match {
  case Nil() => None()
  case Cons(m, rest) =>
    if (m.id == id) Some(m) else findMonsterById(rest, id)
}


def removeMonster(monsters: List[Monster], id: Int): List[Monster] = monsters match {
  case Nil() => Nil()
  case Cons(m, rest) =>
    if (m.id == id) removeMonster(rest, id)
    else Cons(m, removeMonster(rest, id))
}


def updateMonster(monsters: List[Monster], mm: Monster): List[Monster] =
  Cons(mm, removeMonster(monsters, mm.id))


def manhattan(a: Pos, b: Pos): Int =
  absInt(a.x - b.x) + absInt(a.y - b.y)


def neighbors4(p: Pos): List[Pos] =
  Cons(Pos(p.x + 1, p.y),
  Cons(Pos(p.x - 1, p.y),
  Cons(Pos(p.x, p.y + 1),
  Cons(Pos(p.x, p.y - 1), Nil()))))


def isFreeTile(d: Dungeon, monsters: List[Monster], p: Pos): Bool =
  isWalkable(tileAt(d, p)) &&
  (findMonsterAt(monsters, p) match { case None() => true; case Some(_) => false })


def bestToward(d: Dungeon, monsters: List[Monster], from: Pos, to: Pos): Option[Pos] = {
  def loop(cands: List[Pos], best: Option[Pos]): Option[Pos] = cands match {
    case Nil() => best
    case Cons(p, rest) =>
      if (util::not(isFreeTile(d, monsters, p))) loop(rest, best)
      else best match {
        case None() => loop(rest, Some(p))
        case Some(b) =>
          if (manhattan(p, to) < manhattan(b, to)) loop(rest, Some(p)) else loop(rest, best)
      }
  }
  loop(neighbors4(from), None())
}


def pickFreeNeighbor(d: Dungeon, monsters: List[Monster], from: Pos): Option[Pos] / Rng = {
  def collect(xs: List[Pos], acc: List[Pos]): List[Pos] = xs match {
    case Nil() => acc
    case Cons(p, rest) =>
      if (isFreeTile(d, monsters, p)) collect(rest, Cons(p, acc)) else collect(rest, acc)
  }

  val freeRev = collect(neighbors4(from), Nil())
  val free = reverse(freeRev, Nil())

  free match {
    case Nil() => None()
    case _ =>
      val n = length(free)
      val i = do nextInt(n)
      headOpt(dropN(free, i))
  }
}


def diffName(d: Int): String =
  if (d == 1) "Easy"
  else if (d == 3) "Hard"
  else "Medium"


def playerHpFor(diff: Int): Int =
  if (diff == 1) 16
  else if (diff == 3) 10
  else 12


def monsterCountFor(diff: Int): Int =
  if (diff == 1) 6
  else if (diff == 3) 12
  else 8


def goblinAggro(diff: Int): Int =
  if (diff == 1) 6
  else if (diff == 3) 10
  else 8


def ratAggro(diff: Int): Int =
  if (diff == 1) 2
  else if (diff == 3) 4
  else 3


def monsterHp(k: MonsterKind, diff: Int): Int = k match {
  case Goblin() =>
    if (diff == 1) 5 else if (diff == 3) 7 else 6
  case Rat() =>
    if (diff == 1) 3 else if (diff == 3) 5 else 4
}


def kindName(k: MonsterKind): String = k match {
  case Goblin() => "goblin"
  case Rat() => "rat"
}


def dmgPlayer(): Int = 3


def monsterDamage(k: MonsterKind, diff: Int): Int = k match {
  case Goblin() => if (diff == 3) 3 else 2
  case Rat() => if (diff == 3) 2 else 1
}


def decideMonster(m: Monster, w: World): Action / Rng = {
  val ppos = w.player.pos
  val dist = manhattan(m.pos, ppos)

  if (dist == 1) {
    Move(ppos.x - m.pos.x, ppos.y - m.pos.y)
  } else {
    m.kind match {
      case Goblin() =>
        if (dist <= goblinAggro(w.diff)) {
          bestToward(w.dungeon, w.monsters, m.pos, ppos) match {
            case None() => Wait()
            case Some(step) => Move(step.x - m.pos.x, step.y - m.pos.y)
          }
        } else {
          pickFreeNeighbor(w.dungeon, w.monsters, m.pos) match {
            case None() => Wait()
            case Some(step) => Move(step.x - m.pos.x, step.y - m.pos.y)
          }
        }

      case Rat() =>
        if (dist <= ratAggro(w.diff)) {
          bestToward(w.dungeon, w.monsters, m.pos, ppos) match {
            case None() => Wait()
            case Some(step) => Move(step.x - m.pos.x, step.y - m.pos.y)
          }
        } else {
          pickFreeNeighbor(w.dungeon, w.monsters, m.pos) match {
            case None() => Wait()
            case Some(step) => Move(step.x - m.pos.x, step.y - m.pos.y)
          }
        }
    }
  }
}


def applyPlayerAction(act: Action): Unit / {GameState, Log} = {
  val w = do get()
  w.status match {
    case Playing() =>
      act match {
        case QuitCmd() =>
          do put(World(w.dungeon, w.player, w.monsters, QuitGame(), w.turn, w.diff))
          do model::write("You quit.")
        case Wait() =>
          do model::write("You wait.")
        case Move(dx, dy) =>
          val dest = Pos(w.player.pos.x + dx, w.player.pos.y + dy)
          if (util::not(inBounds(w.dungeon, dest))) {
            do model::write("You cannot go there.")
          } else {
            val t = tileAt(w.dungeon, dest)
            if (util::not(isWalkable(t))) {
              do model::write("A wall blocks your way.")
            } else {
              findMonsterAt(w.monsters, dest) match {
                case None() =>
                  val p2 = Player(dest, w.player.hp)
                  t match {
                    case Exit() =>
                      do model::write("You reached the exit. You win.")
                      do put(World(w.dungeon, p2, w.monsters, Won(), w.turn, w.diff))
                    case _ =>
                      do put(World(w.dungeon, p2, w.monsters, Playing(), w.turn, w.diff))
                  }
                case Some(m) =>
                  val hp2 = m.hp - dmgPlayer()
                  if (hp2 < 1) {
                    do model::write("You kill the " ++ kindName(m.kind) ++ ".")
                    do put(World(w.dungeon, w.player, removeMonster(w.monsters, m.id), w.status, w.turn, w.diff))
                  } else {
                    do model::write("You hit the " ++ kindName(m.kind) ++ ".")
                    val m2 = Monster(m.id, m.kind, m.pos, hp2)
                    do put(World(w.dungeon, w.player, updateMonster(w.monsters, m2), w.status, w.turn, w.diff))
                  }
              }
            }
          }
      }
    case _ => ()
  }
}


def applyMonsterAction(mid: Int, act: Action): Unit / {GameState, Log} = {
  val w = do get()
  w.status match {
    case Playing() =>
      findMonsterById(w.monsters, mid) match {
        case None() => ()
        case Some(m) =>
          act match {
            case QuitCmd() => ()
            case Wait() => ()
            case Move(dx, dy) =>
              val dest = Pos(m.pos.x + dx, m.pos.y + dy)
              val ppos = w.player.pos

              if (eqPos(dest, ppos)) {
                val dmg = monsterDamage(m.kind, w.diff)
                val hp2 = w.player.hp - dmg
                if (hp2 < 1) {
                  do model::write("The " ++ kindName(m.kind) ++ " hits you. You die.")
                  do put(World(w.dungeon, Player(ppos, 0), w.monsters, Lost(), w.turn, w.diff))
                } else {
                  do model::write("The " ++ kindName(m.kind) ++ " hits you.")
                  do put(World(w.dungeon, Player(ppos, hp2), w.monsters, w.status, w.turn, w.diff))
                }
              } else {
                if (isFreeTile(w.dungeon, w.monsters, dest)) {
                  val moved = Monster(m.id, m.kind, dest, m.hp)
                  do put(World(w.dungeon, w.player, updateMonster(w.monsters, moved), w.status, w.turn, w.diff))
                } else ()
              }
          }
      }
    case _ => ()
  }
}


def monsterIds(ms: List[Monster]): List[Int] = ms match {
  case Nil() => Nil()
  case Cons(m, rest) => Cons(m.id, monsterIds(rest))
}


def monstersTurn(ids: List[Int]): Unit / {GameState, Controller, Log} = ids match {
  case Nil() => ()
  case Cons(id, rest) =>
    val w = do get()
    w.status match {
      case Playing() =>
        val act = do choose(MonsterActor(id), w)
        applyMonsterAction(id, act)
        monstersTurn(rest)
      case _ => ()
    }
}


def pickFloorPos(d: Dungeon): Pos / Rng = {
  def loop(): Pos / Rng = {
    val x = do nextInt(d.w)
    val y = do nextInt(d.h)
    val p = Pos(x, y)
    if (isFloor(tileAt(d, p))) p else loop()
  }
  loop()
}


def pickSpawnPos(d: Dungeon, start: Pos, acc: List[Monster]): Pos / Rng = {
  val p = pickFloorPos(d)
  if (eqPos(p, start)) pickSpawnPos(d, start, acc)
  else
    findMonsterAt(acc, p) match {
      case Some(_) => pickSpawnPos(d, start, acc)
      case None() => p
    }
}


def spawnMonstersRandom(d: Dungeon, start: Pos, n: Int, nextId: Int, diff: Int, acc: List[Monster]): List[Monster] / Rng =
  if (n < 1) acc
  else {
    val p = pickSpawnPos(d, start, acc)
    val k = if (do nextInt(2) == 0) Goblin() else Rat()
    val hp = monsterHp(k, diff)
    spawnMonstersRandom(d, start, n - 1, nextId + 1, diff, Cons(Monster(nextId, k, p, hp), acc))
  }


def spawnMonsters(d: Dungeon, start: Pos, total: Int, diff: Int): List[Monster] / Rng =
  if (total < 1) Nil()
  else if (total == 1) spawnMonstersRandom(d, start, 1, 1, diff, Nil())
  else {
    val pG = pickSpawnPos(d, start, Nil())
    val g = Monster(1, Goblin(), pG, monsterHp(Goblin(), diff))
    val pR = pickSpawnPos(d, start, Cons(g, Nil()))
    val r = Monster(2, Rat(), pR, monsterHp(Rat(), diff))
    spawnMonstersRandom(d, start, total - 2, 3, diff, Cons(r, Cons(g, Nil())))
  }


def initWorld(diff: Int): World / Rng = {
  val (d, start) = generateDungeon(40, 20)
  val player = Player(start, playerHpFor(diff))
  val monsters = spawnMonsters(d, start, monsterCountFor(diff), diff)
  World(d, player, monsters, Playing(), 1, diff)
}
