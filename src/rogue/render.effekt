module src/rogue/render

import list
import option
import string

import src/rogue/util
import src/rogue/model
import src/rogue/dungeon
import src/rogue/logic

def tileChar(t: Tile): String = t match {
  case Wall() => "#"
  case Floor() => "."
  case Exit() => ">"
}

def monsterChar(k: MonsterKind): String = k match {
  case Goblin() => "G"
  case Rat() => "r"
}

def renderHeader(w: World): String = w.status match {
  case Playing() => "RogueCellar"
  case Won() => "RogueCellar - YOU WIN"
  case Lost() => "RogueCellar - GAME OVER"
  case QuitGame() => "RogueCellar - QUIT"
}

def renderStats(w: World): String =
  "HP: " ++ show(w.player.hp) ++
  "   Turn: " ++ show(w.turn) ++
  "   Monsters: " ++ show(length(w.monsters)) ++
  "   Diff: " ++ diffName(w.diff) ++
  "   Keys: e(up) s(left) d(down) f(right)"


def renderRow(w: World, y: Int, x: Int): String =
  if (x == w.dungeon.w) ""
  else {
    val p = Pos(x, y)
    val s =
      if (eqPos(p, w.player.pos)) "@"
      else
        findMonsterAt(w.monsters, p) match {
          case Some(m) => monsterChar(m.kind)
          case None() => tileChar(tileAt(w.dungeon, p))
        }
    s ++ renderRow(w, y, x + 1)
  }


def renderMap(w: World, y: Int): String =
  if (y == w.dungeon.h) ""
  else {
    val line = renderRow(w, y, 0)
    if (y == w.dungeon.h - 1) line
    else line ++ "\n" ++ renderMap(w, y + 1)
  }


def joinLines(xs: List[String]): String = xs match {
  case Nil() => ""
  case Cons(h, Nil()) => h
  case Cons(h, t) => h ++ "\n" ++ joinLines(t)
}


def renderLogs(logsNewestFirst: List[String]): String = {
  val shownNewest = util::take(logsNewestFirst, 6)
  val shown = reverse(shownNewest, Nil())
  shown match {
    case Nil() => ""
    case _ => "\n" ++ joinLines(shown)
  }
}


def parseAction(line0: String): Option[Action] = {
  val line = trim(line0)
  if (line == "e" || line == "E") Some(Move(0, -1))
  else if (line == "d" || line == "D") Some(Move(0, 1))
  else if (line == "s" || line == "S") Some(Move(-1, 0))
  else if (line == "f" || line == "F") Some(Move(1, 0))
  else if (line == "." || line == "wait" || line == "WAIT") Some(Wait())
  else if (line == "q" || line == "Q" || line == "quit" || line == "QUIT") Some(QuitCmd())
  else None()
}
